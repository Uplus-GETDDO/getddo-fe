# 백엔드 API 베이스 URL
# MSW 목업으로 개발할 때는 /api (같은 origin)로 둬야 서비스워커가 요청을 가로챈다.
# Vercel 배포도 /api 유지 — vercel.json이 /api/* 를 실서버로 프록시한다.
# 로컬에서 백엔드에 직접 붙을 때만 http://localhost:8080/api 같은 절대 URL로 바꾼다.
VITE_API_BASE_URL=/api

# MSW 목업 서버 활성화 여부 — 로컬 개발 전용이다.
# 배포 빌드는 vercel.json build.env에서 false로 고정돼 브라우저 목업이 시작되지 않는다.
VITE_ENABLE_MSW=true

# 시연용 가상 사용자 목록(JSON 배열, 한 줄) — 모든 환경에서 필수다.
# 미설정이나 형식 오류면 로그인 화면에 설정 안내가 표시되고 샘플로 대체되지 않는다.
# id는 실서버 DB에 등록된 UUID여야 한다(아니면 401 USER-002).
# 형식: [{"id":"<uuid>","name":"김도윤","role":"USER","membership":"vip","personaLabel":"데일리 루틴러"}]
# 로컬 전체 목업 개발용 샘플 — mocks/handlers의 가상 사용자 ID와 맞춰야 목업이 받아준다:
# VITE_VIRTUAL_USERS_JSON=[{"id":"vu-doyoon","name":"김도윤","role":"USER","membership":"excellent","personaLabel":"데일리 루틴러"},{"id":"vu-admin","name":"관리자","role":"ADMIN","membership":"excellent","personaLabel":null}]
# Vercel 대시보드 환경변수에는 실제 등록 계정 JSON을 넣고 재배포한다.
# VITE_VIRTUAL_USERS_JSON=
