        "msw": "^2.15.0",
        "oxc-transform-react": "0.145.0",
        "prettier": "^3.9.7",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "shadcn": "^4.21.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
