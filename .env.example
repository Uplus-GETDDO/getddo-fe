# 백엔드 API 베이스 URL
# MSW 목업으로 개발할 때는 /api (같은 origin)로 둬야 서비스워커가 요청을 가로챈다.
# Vercel 배포도 /api 유지 — vercel.json이 /api/* 를 실서버로 프록시한다.
# 로컬에서 백엔드에 직접 붙을 때만 http://localhost:8080/api 같은 절대 URL로 바꾼다.
VITE_API_BASE_URL=/api

# MSW 목업 서버 활성화 여부 — 로컬 개발 전용이다.
# 배포 빌드는 vercel.json build.env에서 false로 고정돼 브라우저 목업이 시작되지 않는다.
VITE_ENABLE_MSW=true

# 시연용 가상 사용자 목록(JSON 배열, 한 줄) — 모든 환경에서 필수다.
# 미설정이나 형식 오류면 로그인 화면에 설정 안내가 표시되고 샘플로 대체되지 않는다.
# id는 실서버 DB에 등록된 UUID여야 한다(아니면 401 USER-002).
# 형식: [{"id":"<uuid>","name":"김도윤","role":"USER","membership":"vip","personaLabel":"데일리 루틴러"}]
# 로컬 전체 목업 개발용 샘플 — mocks/handlers의 가상 사용자 ID와 맞춰야 목업이 받아준다:
# VITE_VIRTUAL_USERS_JSON=[{"id":"vu-doyoon","name":"김도윤","role":"USER","membership":"excellent","personaLabel":"데일리 루틴러"},{"id":"vu-admin","name":"관리자","role":"ADMIN","membership":"excellent","personaLabel":null}]
# Vercel 대시보드 환경변수에는 실제 등록 계정 JSON을 넣고 재배포한다.
# 등록된 시연 계정(2026-10-21, 실서버 검증 완료) — 그대로 복사해 사용할 수 있다.
# 목업의 4인 페르소나와 멤버십이 1:1로 대응된다(사용자1=김도윤, 2=최민준, 3=박서연, 5=이하늘).
# DB에는 vip 예비 계정 테스트사용자4(01a14280-f678-725e-9a73-f62eeb5b7976)도 있지만
# 페르소나 없는 잉여 계정이라 선택 목록에서는 제외한다 — 멤버십별 이중 계정이 필요하면 끝에 추가.
# VITE_VIRTUAL_USERS_JSON=[{"id":"01a14280-f678-7617-9364-6b79d2dcbef2","name":"테스트사용자1","role":"USER","membership":"excellent","personaLabel":"데일리 루틴러"},{"id":"01a14280-f678-71f8-b154-11b44c1926f2","name":"테스트사용자2","role":"USER","membership":"excellent","personaLabel":"라이트 참여형"},{"id":"01a14280-f678-7f8e-b785-3bcfdd11279b","name":"테스트사용자3","role":"USER","membership":"vip","personaLabel":"타임어택 헌터"},{"id":"01a14280-f678-7100-9c3d-ffb9873fadcf","name":"테스트사용자5","role":"USER","membership":"vvip","personaLabel":"신뢰중시 확인러"},{"id":"01a14280-f677-7a0a-a066-5553d7344fd2","name":"테스트관리자","role":"ADMIN","membership":"excellent","personaLabel":null}]
# VITE_VIRTUAL_USERS_JSON=
