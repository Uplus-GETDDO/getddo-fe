        "class-variance-authority": "^0.7.1",
        "cn": "^0.3.0",
        "framer-motion": "^13.4.0",
        "lucide-react": "^1.46.0",
        "radix-ui": "^1.6.7",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-hook-form": "^7.88.0",
        "react-is": "^19.3.1",
        "react-router-dom": "^7.18.4",
        "recharts": "^3.10.1",
        "sonner": "^2.0.8",
