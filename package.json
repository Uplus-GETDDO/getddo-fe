{
    "name": "getddo-fe",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "perf:budget": "node scripts/checkBundleBudget.mjs",
